# ---------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in the values.
# Get these from https://www.sanity.io/manage  (create a free project).
# ---------------------------------------------------------------------------

# Your Sanity project id (e.g. "ab12cd34")
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id

# Dataset name (use "production")
NEXT_PUBLIC_SANITY_DATASET=production

# API version (date string; leave as-is unless you know better)
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---------------------------------------------------------------------------
# WRITE TOKEN — only used by the import script (scripts/import-catalog.ts).
# Create one at: Sanity Manage > API > Tokens > Add token (Editor permission).
# NEVER expose this in client code or commit it.
# ---------------------------------------------------------------------------
SANITY_API_WRITE_TOKEN=your_write_token

# ---------------------------------------------------------------------------
# Local catalogue folder the import script reads from.
# Defaults to C:\catalog if omitted.
# Use double backslashes on Windows.
# ---------------------------------------------------------------------------
CATALOG_PATH=C:\\catalog

# ---------------------------------------------------------------------------
# Public site URL — used to generate the in-store QR codes at /qr.
# Set this to your live domain (e.g. https://shellselect.gulbaan.com).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://shellselect.gulbaan.com

# ---------------------------------------------------------------------------
# Analytics (optional — scripts only load if these are set).
#   GA4 measurement id  -> looks like "G-XXXXXXXXXX"
#   Clarity project id  -> looks like "abcdefghij"
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
